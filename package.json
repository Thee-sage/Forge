{
  "name": "forge-engine",
  "version": "0.1.0",
  "description": "Forge — a modular Financial Reasoning Engine that turns structured financial data into explainable, evidence-based insights.",
  "type": "module",
  "bin": {
    "forge": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "forge": "tsx src/cli/index.ts",
    "web": "tsx src/cli/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eval.json",
    "clean": "rimraf dist",
    "validate:accuracy": "tsx evaluation/run.ts",
    "eval:build-datasets": "tsx evaluation/datasets/src/build.ts",
    "validate:accuracy:compare": "tsx evaluation/compare.ts",
    "validate:accuracy:verify": "tsx evaluation/verify-artifacts.ts",
    "eval:label-pack": "tsx evaluation/label-pack.ts"
  },
  "keywords": [
    "finance",
    "financial-analysis",
    "reasoning-engine",
    "explainable",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
